  ],
  "share_target": {
    "action": "./nahravky.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": ["audio/*", ".m4a", ".mp3", ".wav", ".aac"]
        }
      ]
    }
  }
