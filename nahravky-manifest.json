  "display": "standalone",
  "background_color": "#0f0f10",
  "theme_color": "#d32f2f",
  "orientation": "portrait",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
